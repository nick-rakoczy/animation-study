{
  "name": "animation-study",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/src/main/main.js",
  "description": "Local tools for studying animation timing",
  "bin": {
    "animation-study-probe": "dist/src/cli.js"
  },
  "scripts": {
    "build": "npm run build:core && npm run build:renderer",
    "build:core": "tsc -p tsconfig.json",
    "build:renderer": "tsc -p renderer/tsconfig.json && vite build",
    "benchmark:frame-step": "npm run build:core && node dist/src/frame-step-benchmark.js",
    "start": "npm run build && electron .",
    "probe": "node dist/src/cli.js",
    "test": "npm run build && node --test dist/**/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p renderer/tsconfig.json",
    "dist:linux": "npm run build && electron-builder --linux AppImage --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.0",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=12"
  },
  "build": {
    "appId": "com.animationstudy.app",
    "productName": "Animation Study",
    "asar": true,
    "files": [
      "dist/src/**/*",
      "renderer-dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "nick-rakoczy",
      "repo": "animation-study"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Graphics",
      "artifactName": "Animation-Study-${version}-x86_64.${ext}"
    }
  }
}
