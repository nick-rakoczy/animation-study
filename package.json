{
  "name": "animation-study",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/src/main/main.js",
  "description": "Local tools for studying animation timing",
  "bin": {
    "animation-study-probe": "dist/src/cli.js"
  },
  "scripts": {
    "build": "npm run build:core && npm run build:renderer",
    "build:core": "tsc -p tsconfig.json",
    "build:renderer": "tsc -p renderer/tsconfig.json && vite build",
    "start": "npm run build && electron .",
    "probe": "node dist/src/cli.js",
    "test": "npm run build && node --test dist/**/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p renderer/tsconfig.json"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.3.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.0"
  }
}
